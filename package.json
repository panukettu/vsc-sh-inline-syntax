{
  "name": "sh-inline-syntax",
  "displayName": "Shell inline syntax (awk, jq, sed, python, JMESPath)",
  "version": "0.1.0",
  "description": "Syntax highlighting for awk, jq, sed, python -c, and JMESPath programs embedded in shell scripts.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "awk",
    "bash",
    "jmespath",
    "jpx",
    "jq",
    "python",
    "sed",
    "shell"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/panukettu/vsc-sh-inline-syntax.git"
  },
  "publisher": "0xp",
  "scripts": {
    "build": "bun scripts/build.mts",
    "fmt": "oxfmt --disable-nested-config --write",
    "lint": "oxlint --disable-nested-config",
    "package": "vsce package",
    "publish:vsce": "vsce publish --packagePath sh-inline-syntax-$npm_package_version.vsix",
    "publish:ovsx": "bunx ovsx publish sh-inline-syntax-$npm_package_version.vsix",
    "release:build": "bun run build && bun run package",
    "release:publish": "bun run publish:vsce && bun run publish:ovsx"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "jmespath",
        "aliases": [
          "JMESPath",
          "jpx"
        ],
        "extensions": [
          ".jp",
          ".jpx"
        ],
        "configuration": "./language-configuration/jmespath.json"
      },
      {
        "id": "sed",
        "aliases": [
          "sed"
        ],
        "extensions": [
          ".sed"
        ],
        "firstLine": "^#!.*\\bsed\\b",
        "configuration": "./language-configuration/sed.json"
      }
    ],
    "grammars": [
      {
        "language": "jmespath",
        "scopeName": "source.jmespath",
        "path": "./syntaxes/jmespath.tmLanguage.json"
      },
      {
        "language": "sed",
        "scopeName": "source.sed",
        "path": "./syntaxes/sed.tmLanguage.json"
      },
      {
        "scopeName": "shell.inline-syntax.injection",
        "path": "./syntaxes/shell-injection.tmLanguage.json",
        "injectTo": [
          "source.shell"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.awk": "awk",
          "meta.embedded.block.jq": "jq",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.sed": "sed",
          "meta.embedded.block.jmespath": "jmespath",
          "meta.embedded.inline.jmespath": "jmespath"
        }
      }
    ]
  },
  "extensionDependencies": [
    "edwinkofler.vscode-assorted-languages"
  ],
  "galleryBanner": {
    "color": "#0a0c10",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  }
}
